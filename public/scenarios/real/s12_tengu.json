  "lessons": [
    { "id": "l_back", "when": { "var": "rec.wasLost", "op": "==", "value": true }, "title": "違和感があったら、進まずに戻る", "text": "「こんなに下ったっけ」と思ったときが戻りどき。雪山では、風と雪で自分の足跡がすぐ埋まる。踏み跡・赤布・地形・方角を確かめ、合わなければ足跡が残っているうちに引き返す。" },
    {
      "id": "l_okuniwa",
      "when": { "var": "rec.wasLost", "op": "==", "value": true },
      "title": "迷いやすい場所を知っておく",
      "text": "天狗の奥庭のような岩と低い木の広い窪地は、見通しが悪いと方角を失いやすい。天気の悪い日は、トレースのはっきりした道（登った稜線の道）を戻るのも立派な判断。地図アプリ（GPS）があれば、外れたことにすぐ気づける。"
    },
    { "id": "l_valley", "when": { "flag": "stuck" }, "title": "雪の谷を下らない", "text": "谷の底は吹きだまりで雪が深く、まわりの斜面から雪崩も来る。下りなら進めそうに思えても、谷をさらに下ると戻れなくなる。谷は電波も入りにくい。" },
    { "id": "l_bivouac", "when": { "flag": "nightOut" }, "title": "厳冬期のビバークに備える", "text": "1月の雪の中のビバークは、低体温症と凍傷との戦いになる。ツエルトで風を防ぎ、ザックを敷いて雪から体を離し、着込んで寄り添う。コンロとコッヘルがあれば雪を溶かして温かい飲み物が作れる。シュラフカバーも大きな助けになる。" },
    { "id": "l_cocoheli", "when": { "flag": "nightOut" }, "title": "発信機は、登山計画とセットで", "text": "ココヘリのような発信機は、届け出（登山計画）と家族の通報があってはじめて捜索に使われる。見つけるまでが役割で、救助するのは警察や消防。天気が悪ければ救助は遅れる。一晩、二晩を自分で耐える装備と知識が要る。発信機は雪に埋めず、空に近い所に置く。" },
    { "id": "l_signal", "when": { "var": "rec.wasLost", "op": "==", "value": true }, "title": "尾根では電波が入ることがある", "text": "谷はたいてい圏外。尾根やピークに上がると、携帯電話が通じることがある。" },
    { "id": "l_leader", "title": "厳冬期は経験者と", "text": "雪山の経験が浅い人どうしで厳冬期の山に入らない。ラッセルやトレースのない雪の上を歩く技術と経験のある人と行動する。" },
    { "id": "l_weather", "when": { "not": { "flag": "noSummit" } }, "title": "予報が悪い日は、計画を小さくする", "text": "雪と強風の予報の日は、登らない、登っても同じ道を戻る、など計画を小さくする。稜線の風と見通しの悪さは、昼に向けてさらに悪くなることが多い。" }
  ],
  "balanceTargets": { "recommended": { "goodMin": 0.9, "fatalMax": 0.02 }, "bias": { "goodMax": 0.9, "rescuedMin": 0.08, "fatalMax": 0.08 }, "risky": { "goodMax": 0.5, "fatalMin": 0.03, "rescuedMin": 0.3 } },
  "sources": ["原案: 松本圭司「架空遭難　中高年2名、天狗岳の下りで道迷いから行動不能」note（2024年2月20日） https://note.com/keizi666/n/nff227f385b70", "地形: 国土地理院 標高タイル（DEM10B）・ベクトルタイル（植生記号）を加工", "登山道・地点: © OpenStreetMap contributors"]
