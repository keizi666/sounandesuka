  "endings": [
    { "kind": "SAFE_RETURN", "when": { "flag": "noSummit" }, "title": "登らずに下りた", "text": "二人は天狗岳をあきらめ、渋の湯へ下った。昼前から稜線は吹雪になった。天狗岳は、また天気のいい日に。" },
    {
      "kind": "SAFE_RETURN",
      "when": { "all": [{ "var": "rec.wasLost", "op": "==", "value": true }, { "flag": "stuck" }] },
      "title": "雪の谷から登り返した",
      "text": "二人は奥庭の先で道を外れ、谷の吹きだまりで腰まで雪に埋まった。登山道まで登り返して渋の湯へ下ったが、服の中まで濡れ、体は冷え切っていた。"
    },
    {
      "kind": "SAFE_RETURN",
      "when": { "all": [{ "var": "rec.wasLost", "op": "==", "value": true }, { "chose": { "cp": "generic:lostAware", "option": "backtrack" } }] },
      "title": "足跡をたどって戻った",
      "text": "二人は奥庭で道を外れたが、足跡が埋まる前に登り返し、渋の湯へ下った。気づくのが遅れていれば、深い雪の谷で動けなくなっていたかもしれない。"
    },
    { "kind": "SAFE_RETURN", "when": { "var": "rec.wasLost", "op": "==", "value": true }, "title": "一度は道を外れたが", "text": "二人は吹雪の中で一度踏み跡を外れたが、すぐ道に戻り、渋の湯へ下った。見通しのない雪の中では、道は数十メートルで分からなくなる。" },
    { "kind": "SAFE_RETURN", "when": { "flag": "sameWay" }, "title": "知っている道を戻った", "text": "二人は天狗岳に登り、吹雪の中をトレースのある稜線の道で戻って、渋の湯に着いた。奥庭は、また天気のいい日に。" },
    { "kind": "SAFE_RETURN", "when": { "chose": { "cp": "cp_okuniwa", "option": "follow" } }, "title": "渋の湯に下りた", "text": "二人は吹雪の中で奥庭を抜け、渋の湯へ下った。見えている斜面を下ったが、運よく道を外れずに済んだ。" },
    { "kind": "SAFE_RETURN", "title": "渋の湯に下りた", "text": "二人は吹雪の中で奥庭を抜け、渋の湯へ下った。奥庭では何度も立ち止まり、方角を確かめながら歩いた。" },
    { "kind": "SAFE_SHELTER", "title": "ヒュッテで過ごした", "text": "二人は黒百合ヒュッテに逃げ込み、吹雪の夜を小屋で過ごした。" },
    { "kind": "SELF_RESCUE", "when": { "flag": "nightOut" }, "title": "一晩を越して、自力で", "text": "雪の中で一晩を越した二人は、朝に位置の見当をつけ、新しい雪をこいで登山道へ登り返した。ヒュッテで体を温め、自力で下山した。体温は {rec.minCoreC:1}℃ まで下がっていた。" },
    { "kind": "SELF_RESCUE", "title": "谷から自力で", "text": "谷の吹きだまりで動けなくなった二人は、休んだあと位置の見当をつけて登山道へ登り返し、その日のうちに渋の湯へ下りた。" },
    {
      "kind": "RESCUED",
      "when": { "all": [{ "flag": "frostbite" }, { "flag": "lead:cocoheli" }] },
      "title": "発信機の電波で見つかった",
      "text": "雪の中で一晩を越した二人は、翌日、発信機の電波をたどった救助隊に見つけられた。二人とも指に凍傷を負い、病院で手当てを受けた。登山計画と発信機が居場所を知らせた。"
    },
    { "kind": "RESCUED", "when": { "all": [{ "flag": "nightOut" }, { "flag": "lead:cocoheli" }] }, "title": "発信機の電波で見つかった", "text": "雪の中で一晩を越した二人は、翌日、発信機の電波をたどった救助隊に見つけられた。体は冷え切っていたが、凍傷は免れた。" },
    { "kind": "RESCUED", "when": { "flag": "frostbite" }, "title": "翌日、救助", "text": "雪の中で一晩を越した二人は、翌日、救助隊に見つけられた。二人とも指に凍傷を負い、病院で手当てを受けた。" },
    { "kind": "RESCUED", "when": { "flag": "nightOut" }, "title": "翌日、救助", "text": "雪の中で一晩を越した二人は、翌日、救助隊に見つけられた。体は冷え切っていたが、凍傷は免れた。" },
    { "kind": "RESCUED", "title": "救助", "text": "二人は救助隊に見つけられ、病院へ運ばれた。" },
    {
      "kind": "RESCUED_CRITICAL",
      "when": { "all": [{ "var": "rec.minCoreC", "op": "<", "value": 33.5 }, { "flag": "frostbite" }] },
      "title": "重い低体温症で救助",
      "text": "二人は救助隊に見つけられたが、体温 {rec.minCoreC:1}℃ の重い低体温症で、指には凍傷もあった。病院へ運ばれた。"
    },
    { "kind": "RESCUED_CRITICAL", "when": { "var": "rec.minCoreC", "op": "<", "value": 33.5 }, "title": "重い低体温症で救助", "text": "二人は救助隊に見つけられたが、体温 {rec.minCoreC:1}℃ の重い低体温症で、病院へ運ばれた。" },
    { "kind": "RESCUED_CRITICAL", "title": "重い状態で救助", "text": "二人は救助隊に見つけられたが、一人は雪の斜面で転んで大けがを負い、ヘリで病院へ運ばれた。" },
    { "kind": "FATAL", "when": { "var": "rec.deathCount", "op": ">=", "value": 2 }, "title": "帰らぬ人に", "text": "三浦さんと大野さんは、厳冬期の雪の中で力尽き、亡くなっているのが見つかった。" },
    {
      "kind": "FATAL",
      "when": { "all": [{ "var": "c.ono.alive", "op": "==", "value": false }, { "var": "c.miura.state", "op": "==", "value": "RESCUED" }] },
      "title": "一人が帰らなかった",
      "text": "大野さんは、雪の中で帰らぬ人となった。三浦さんは救助隊に収容され、病院へ運ばれた。"
    },
    {
      "kind": "FATAL",
      "when": { "all": [{ "var": "c.miura.alive", "op": "==", "value": false }, { "var": "c.ono.state", "op": "==", "value": "RESCUED" }] },
      "title": "一人が帰らなかった",
      "text": "三浦さんは、雪の中で帰らぬ人となった。大野さんは救助隊に収容され、病院へ運ばれた。"
    },
    { "kind": "FATAL", "title": "帰らぬ人に", "text": "雪の中で、一人が帰らぬ人となった。" },
    { "kind": "MISSING", "title": "まだ見つかっていない", "text": "翌日の夕方になっても、二人は見つかっていない。" }
  ],
  "lessons": [
    { "id": "l_back", "when": { "var": "rec.wasLost", "op": "==", "value": true }, "title": "違和感があったら、進まずに戻る", "text": "「こんなに下ったっけ」と思ったときが戻りどき。雪山では足跡がすぐ埋まる。踏み跡・赤布・地形・方角が合わなければ、足跡が残るうちに引き返す。" },
    {
      "id": "l_okuniwa",
      "when": { "var": "rec.wasLost", "op": "==", "value": true },
      "title": "迷いやすい場所を知っておく",
      "text": "奥庭のような広い窪地は、見通しが悪いと方角を失いやすい。天気の悪い日は、トレースのある登った道を戻るのも立派な判断。地図アプリ（GPS）があれば、外れたことにすぐ気づける。"
    },
    { "id": "l_valley", "when": { "flag": "stuck" }, "title": "雪の谷を下らない", "text": "谷の底は吹きだまりで雪が深く、雪崩も来る。下りなら進めそうでも、下るほど戻れなくなる。谷は電波も入りにくい。" },
    { "id": "l_bivouac", "when": { "flag": "nightOut" }, "title": "厳冬期のビバークに備える", "text": "1月のビバークは低体温症と凍傷との戦い。ツエルトで風を防ぎ、ザックを敷いて雪から離れ、着込んで寄り添う。コンロがあれば雪を溶かして温かい飲み物が作れ、シュラフカバーも助けになる。" },
    { "id": "l_cocoheli", "when": { "flag": "nightOut" }, "title": "発信機は、登山計画とセットで", "text": "発信機は、登山計画と家族の通報があってはじめて捜索に使われる。見つけるまでが役割で、天気が悪ければ救助は遅れる。一晩、二晩を耐える装備と知識が要る。発信機は雪に埋めず、空に近い所に置く。" },
    { "id": "l_signal", "when": { "var": "rec.wasLost", "op": "==", "value": true }, "title": "尾根では電波が入ることがある", "text": "谷はたいてい圏外。尾根やピークに上がると、携帯電話が通じることがある。" },
    { "id": "l_leader", "title": "厳冬期は経験者と", "text": "雪山の経験が浅い人どうしで厳冬期の山に入らない。トレースのない雪の上を歩ける経験者と行く。" },
    { "id": "l_weather", "when": { "not": { "flag": "noSummit" } }, "title": "予報が悪い日は、計画を小さくする", "text": "雪と強風の予報の日は、登らない・同じ道を戻るなど計画を小さくする。稜線の風と見通しは、昼に向けて悪くなることが多い。" }
