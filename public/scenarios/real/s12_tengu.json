  "endings": [
    { "kind": "SAFE_RETURN", "when": { "flag": "noSummit" }, "title": "登らずに下りた", "text": "三浦さんと大野さんは天狗岳をあきらめ、黒百合ヒュッテから渋の湯へ下った。昼前から稜線は吹雪になった。天狗岳はまた天気のいい日に登ればいい。" },
    {
      "kind": "SAFE_RETURN",
      "when": { "all": [{ "var": "rec.wasLost", "op": "==", "value": true }, { "flag": "stuck" }] },
      "title": "雪の谷から登り返した",
      "text": "二人は奥庭の先で道を外れ、谷の吹きだまりで腰まで雪に埋まった。もがいた末に登山道まで登り返し、ヒュッテを経て渋の湯へ下った。服の中まで雪で濡れ、体は冷え切っていた。"
    },
    {
      "kind": "SAFE_RETURN",
      "when": { "all": [{ "var": "rec.wasLost", "op": "==", "value": true }, { "chose": { "cp": "generic:lostAware", "option": "backtrack" } }] },
      "title": "足跡をたどって戻った",
      "text": "二人は奥庭で一度道を外れ、谷へ下りかけた。おかしいと気づいて、自分たちの足跡が雪に埋まる前に登り返し、ヒュッテに戻って渋の湯へ下った。気づくのが遅れていれば、深い雪の谷で動けなくなっていたかもしれない。"
    },
    { "kind": "SAFE_RETURN", "when": { "var": "rec.wasLost", "op": "==", "value": true }, "title": "一度は道を外れたが", "text": "吹雪の中で二人は一度踏み跡を外れたが、すぐに道に戻ることができ、ヒュッテを経て渋の湯へ下った。見通しのない雪の中では、道はほんの数十メートルで分からなくなる。" },
    { "kind": "SAFE_RETURN", "when": { "flag": "sameWay" }, "title": "知っている道を戻った", "text": "二人は天狗岳に登り、吹雪の中、トレースのはっきりした稜線の道を戻って黒百合ヒュッテへ下り、渋の湯に着いた。奥庭は、また天気のいい日に歩けばいい。" },
    { "kind": "SAFE_RETURN", "title": "渋の湯に下りた", "text": "二人は天狗岳に登り、吹雪の中で天狗の奥庭を抜けて、黒百合ヒュッテから渋の湯へ下った。奥庭では何度も立ち止まり、方角を確かめながら歩いた。" },
    { "kind": "SAFE_SHELTER", "title": "ヒュッテで過ごした", "text": "二人は黒百合ヒュッテに逃げ込み、吹雪の夜を小屋で過ごした。" },
    { "kind": "SELF_RESCUE", "when": { "flag": "nightOut" }, "title": "一晩を越して、自力で", "text": "雪の中で一晩を越した二人は、朝、見通しが戻ったところで位置の見当をつけ、新しい雪をこいで登山道まで登り返した。黒百合ヒュッテで体を温め、自力で下山した。体温は {rec.minCoreC:1}℃ まで下がっていた。" },
    { "kind": "SELF_RESCUE", "title": "谷から自力で", "text": "谷の吹きだまりで動けなくなった二人は、ツエルトをかぶって休んだあと、地図とコンパスで位置の見当をつけ、登山道まで登り返した。その日のうちに渋の湯へ下りた。" },
    {
      "kind": "RESCUED",
      "when": { "all": [{ "flag": "frostbite" }, { "flag": "lead:cocoheli" }] },
      "title": "発信機の電波で見つかった",
      "text": "雪の中で一晩を越した二人は、翌日、発信機の電波をたどってきた救助隊に見つけられた。二人とも手足の指に凍傷を負い、病院で手当てを受けた。登山計画と発信機が、二人の居場所を知らせた。"
    },
    { "kind": "RESCUED", "when": { "all": [{ "flag": "nightOut" }, { "flag": "lead:cocoheli" }] }, "title": "発信機の電波で見つかった", "text": "雪の中で一晩を越した二人は、翌日、発信機の電波をたどってきた救助隊に見つけられた。体は冷え切っていたが、凍傷は免れた。" },
    { "kind": "RESCUED", "when": { "flag": "frostbite" }, "title": "翌日、救助", "text": "雪の中で一晩を越した二人は、翌日、捜索に入った救助隊に見つけられた。二人とも手足の指に凍傷を負い、病院で手当てを受けた。" },
    { "kind": "RESCUED", "when": { "flag": "nightOut" }, "title": "翌日、救助", "text": "雪の中で一晩を越した二人は、翌日、捜索に入った救助隊に見つけられた。体は冷え切っていたが、凍傷は免れた。" },
    { "kind": "RESCUED", "title": "救助", "text": "二人は救助隊に見つけられ、病院へ運ばれた。" },
    {
      "kind": "RESCUED_CRITICAL",
      "when": { "all": [{ "var": "rec.minCoreC", "op": "<", "value": 33.5 }, { "flag": "frostbite" }] },
      "title": "重い低体温症で救助",
      "text": "二人は救助隊に見つけられたが、体温が {rec.minCoreC:1}℃ まで下がった重い低体温症で、病院へ運ばれた。手足の指には凍傷があった。"
    },
    { "kind": "RESCUED_CRITICAL", "when": { "var": "rec.minCoreC", "op": "<", "value": 33.5 }, "title": "重い低体温症で救助", "text": "二人は救助隊に見つけられたが、体温が {rec.minCoreC:1}℃ まで下がった重い低体温症で、病院へ運ばれた。" },
    { "kind": "RESCUED_CRITICAL", "title": "重い状態で救助", "text": "二人は救助隊に見つけられたが、一人は雪の斜面で転んで大けがを負っていた。ヘリで病院へ運ばれた。" },
    { "kind": "FATAL", "when": { "var": "rec.deathCount", "op": ">=", "value": 2 }, "title": "帰らぬ人に", "text": "三浦さんと大野さんは、雪の中で亡くなっているのが見つかった。厳冬期の雪の中で、二人とも力尽きた。" },
    {
      "kind": "FATAL",
      "when": { "all": [{ "var": "c.ono.alive", "op": "==", "value": false }, { "var": "c.miura.state", "op": "==", "value": "RESCUED" }] },
      "title": "一人が帰らなかった",
      "text": "大野さんは、雪の中で帰らぬ人となった。三浦さんは救助隊に収容され、病院へ運ばれた。"
    },
    {
      "kind": "FATAL",
      "when": { "all": [{ "var": "c.miura.alive", "op": "==", "value": false }, { "var": "c.ono.state", "op": "==", "value": "RESCUED" }] },
      "title": "一人が帰らなかった",
      "text": "三浦さんは、雪の中で帰らぬ人となった。大野さんは救助隊に収容され、病院へ運ばれた。"
    },
    { "kind": "FATAL", "title": "帰らぬ人に", "text": "雪の中で、一人が帰らぬ人となった。" },
    { "kind": "MISSING", "title": "まだ見つかっていない", "text": "翌日の夕方になっても、二人は見つかっていない。" }
