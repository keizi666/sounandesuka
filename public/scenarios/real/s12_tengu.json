    { "key": "s12_white", "who": "miura", "when": { "all": [{ "state": "WALKING" }, { "var": "leader.local.visibilityM", "op": "<", "value": 60 }] }, "lines": ["真っ白だ。足元の雪と空の区別がつかない", "赤布が見えない。次はどっちだ"], "priority": 7 },
    { "key": "s12_off", "who": "miura", "when": { "state": "OFFROUTE_UNAWARE" }, "lines": ["下りが続くな。ヒュッテはこんなに下だったか", "踏み跡が消えた。風で埋まったんだろう"], "priority": 8 },
    {
