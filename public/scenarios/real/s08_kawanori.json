    { "key": "s08_aware", "who": "leader", "when": { "all": [{ "state": "LOST_AWARE" }, { "not": { "flag": "carefulNav" } }] }, "lines": ["いつ道を外れたんだ。覚えていない", "地形図のどこにいるのか、分からない"], "priority": 8 },
    { "key": "s08_descend", "who": "leader", "when": { "all": [{ "state": "DESCENDING_DRAINAGE" }, { "not": { "flag": "reachedRindo" } }] }, "lines": ["沢は東へ流れている。大丹波川に出るはずだ", "落ち葉の斜面は滑る。一歩ずつだ"], "priority": 8 },
    {
      "key": "s08_bruise",
      "who": "leader",
      "when": {
        "all": [
          { "var": "leader.injury", "op": "==", "value": "bruise" },
          { "any": [{ "state": "LOST_AWARE" }, { "state": "STAYING" }, { "state": "DESCENDING_DRAINAGE" }, { "state": "BACKTRACKING" }, { "state": "NAVIGATING_TO_TRAIL" }] }
        ]
      },
      "lines": ["体中が痛い。でも歩ける。落ち着け", "打った腰が痛む。足元に気をつけないと"],
      "priority": 9
    },
    { "key": "s08_676", "who": "leader", "when": { "all": [{ "state": "WALKING" }, { "onEdge": "E9" }] }, "lines": ["尾根筋を外さないように。末端まで下れば出合いだ", "道はないが、尾根の上なら滝はない"], "priority": 9 },
    { "key": "s08_nav", "who": "leader", "when": { "state": "NAVIGATING_TO_TRAIL" }, "lines": ["地形図どおりなら、この先で道に出る", "沢を渡る所だけは慎重に"], "priority": 8 },
    { "key": "s08_back", "who": "leader", "when": { "state": "BACKTRACKING" }, "lines": ["迷ったら戻る。来た所なら分かる", "落ち葉に自分の足跡が残っている"], "priority": 8 },
    {
      "key": "s08_family",
      "who": "leader",
      "when": { "all": [{ "var": "sun.isDark", "op": "==", "value": true }, { "state": "BIVOUAC" }, { "not": { "flag": "planShared" } }] },
      "lines": ["家族には「川苔山」としか言っていない", "北稜を下るとは、誰にも言っていない"],
      "priority": 9
    },
    { "key": "s08_night", "who": "leader", "when": { "all": [{ "var": "sun.isDark", "op": "==", "value": true }, { "state": "BIVOUAC" }] }, "lines": ["シートが風でばたつく。明日は雨だ", "寒い。でも朝まではもつ"], "priority": 8 },
    { "key": "s08_night2", "who": "leader", "when": { "all": [{ "var": "sun.isDark", "op": "==", "value": true }, { "state": "BIVOUAC" }] }, "lines": ["沢の音が大きく聞こえる", "朝になれば尾根の形が見える。それまで待とう"], "priority": 8 },
    { "key": "s08_night3", "who": "leader", "when": { "all": [{ "var": "sun.isDark", "op": "==", "value": true }, { "state": "BIVOUAC" }] }, "lines": ["腕時計を見た。夜明けはまだ遠い", "家では今ごろ、電話を待っているだろう"], "priority": 8 },
    { "key": "s08_dawn", "who": "leader", "when": { "all": [{ "after": "D1 04:00" }, { "before": "D1 06:30" }, { "state": "BIVOUAC" }] }, "lines": ["空が少し白んできた", "雨の音が強くなってきた。今日は動けるだろうか"], "priority": 9 },
    {
      "key": "s08_rain",
      "who": "leader",
      "when": { "all": [{ "var": "leader.local.precipMmH", "op": ">", "value": 0.3 }, { "any": [{ "state": "BIVOUAC" }, { "state": "WAITING_RESCUE" }] }] },
      "lines": ["雨がシートを叩く。体を濡らさないように", "水は沢で汲める。食べ物は残しておこう"],
      "priority": 9
    },
    { "key": "s08_rindo", "who": "leader", "when": { "all": [{ "flag": "onRindo" }, { "state": "WALKING" }] }, "lines": ["林道だ……。助かった", "バス停まで歩けば帰れる。運がよかった"], "priority": 10 }
  ],
  "speech": [
    { "key": "s08_summit", "who": "leader", "when": { "beenAt": "SUMMIT" }, "lines": ["着いた。いい眺めだ", "雲取山がよく見える"], "tone": "whisper", "priority": 12, "once": true },
    { "key": "s08_fall", "who": "leader", "when": { "var": "leader.injury", "op": "==", "value": "bruise" }, "lines": ["いてて……。骨は、大丈夫か", "くそっ、滑った……"], "tone": "whisper", "priority": 30, "once": true },
    {
      "key": "s08_fall_bad",
      "who": "leader",
      "when": { "any": [{ "var": "leader.injury", "op": "==", "value": "sprain" }, { "var": "leader.injury", "op": "==", "value": "legFracture" }] },
      "lines": ["うっ……足が……", "まずい、立てない"],
      "tone": "whisper",
      "priority": 30,
      "once": true
    },
    {
      "key": "s08_whistle",
      "who": "leader",
      "when": { "all": [{ "after": "D1 06:00" }, { "var": "sun.isDark", "op": "==", "value": false }, { "any": [{ "state": "BIVOUAC" }, { "state": "WAITING_RESCUE" }] }] },
      "lines": ["（笛）ピーッ、ピーッ、ピーッ", "おーい！ 誰かいませんか！"],
      "tone": "sound",
      "priority": 10,
      "cooldownMin": 90
    }
  ],
  "endings": [
    {
      "kind": "SAFE_RETURN",
      "when": { "all": [{ "beenAt": "TH_OOHINATA" }, { "flag": "reachedRindo" }] },
      "title": "沢を下って林道へ",
      "text": "{leader.name}さんは北稜を外れ、沢を下って大丹波川に出た。川を渡って林道に上がり、大日向のバス停まで歩いた。運がよかった。沢の途中に下りられない滝があれば、行き詰まっていた。"
    },
    {
      "kind": "SAFE_RETURN",
      "when": { "all": [{ "beenAt": "TH_OOHINATA" }, { "flag": "crossedDeai" }] },
      "title": "676 m 標高点の尾根から林道へ",
      "text": "{leader.name}さんは北稜から外れたが、高度計と地形図で現在地を絞り込み、676 m 標高点の小尾根を下った。末端の出合いで沢を渡って林道に出て、大日向のバス停まで歩いた。沢をそのまま下っていたら、滝で行き詰まっていたかもしれない。"
    },
    { "kind": "SAFE_RETURN", "when": { "all": [{ "beenAt": "TH_OOHINATA" }, { "flag": "onRindo" }] }, "title": "林道に出た", "text": "{leader.name}さんは北稜から外れた尾根に入り込んだが、林道に出て大日向のバス停まで歩いた。" },
    {
      "kind": "SAFE_RETURN",
      "when": { "all": [{ "beenAt": "TH_OOHINATA" }, { "var": "rec.wasLost", "op": "==", "value": true }] },
      "title": "引き返して、北稜へ",
      "text": "{leader.name}さんは一度、北稜から外れた尾根に入り込んだ。おかしいと気づいて 1002 m 標高点まで戻り、右へ下る北稜を見つけて大日向のバス停に下りた。気づくのが遅れていれば、急な斜面の先の沢で行き詰まっていたかもしれない。"
    },
    { "kind": "SAFE_RETURN", "when": { "beenAt": "TH_OOHINATA" }, "title": "北稜を下りきった", "text": "{leader.name}さんは真名井北稜を下りきり、大日向のバス停に出た。1002 m 標高点の分かれ目を外さずに歩いた。" },
    { "kind": "SAFE_RETURN", "title": "赤杭尾根を戻った", "text": "{leader.name}さんは来た赤杭尾根を古里駅へ戻った。北稜は、また誰かと一緒に歩けばいい。" },
    { "kind": "SELF_RESCUE", "when": { "var": "leader.injury", "op": "!=", "value": "none" }, "title": "けがをしたまま自力で下山", "text": "{leader.name}さんは、打った体を引きずるようにして一晩を越え、自力で道に出た。家族は前の晩のうちに、警察に届け出ていた。" },
    { "kind": "SELF_RESCUE", "when": { "flag": "planShared" }, "title": "一晩を越えて自力で下山", "text": "{leader.name}さんは道のない斜面で一晩を過ごし、翌日、自力で道に出た。家族に送っていたコースをもとに、警察は真名井北稜を探していた。" },
    { "kind": "SELF_RESCUE", "title": "一晩を越えて自力で下山", "text": "{leader.name}さんは道のない斜面で一晩を過ごし、翌日、自力で道に出た。警察と家族が、行き先の分からないまま探していた。" },
    { "kind": "RESCUED", "when": { "flag": "calledSelf" }, "title": "電話で通報", "text": "{leader.name}さんは電波の入る所から 110 番した。スマホに地図アプリはなく、現在地は口で伝えるしかなかったが、伝えた尾根と高度計の高さを手がかりに、救助隊が見つけ出した。" },
    { "kind": "RESCUED", "when": { "flag": "planShared" }, "title": "救助", "text": "家族に送っておいたコースが手がかりになり、捜索は最初から真名井北稜に向かった。{leader.name}さんは救助隊に見つけられた。" },
    { "kind": "RESCUED", "when": { "flag": "lead:mapcopy" }, "title": "地形図のコピーが手がかりに", "text": "家族が見つけた、赤い線の入った地形図のコピーが手がかりになった。{leader.name}さんは真名井北稜の脇の沢で、救助隊に見つけられた。" },
    { "kind": "RESCUED", "title": "救助", "text": "{leader.name}さんは救助隊に見つけられた。手がかりの少ない中での発見だった。" },
    { "kind": "RESCUED_CRITICAL", "title": "衰弱した状態で救助", "text": "{leader.name}さんは衰弱した状態で見つかり、病院へ運ばれた。" },
    { "kind": "MISSING", "when": { "flag": "planShared" }, "title": "まだ見つかっていない", "text": "3 日目の昼になっても、{leader.name}さんは見つかっていない。捜索は真名井北稜を中心に続いているが、北稜を外れた先には、似たような沢と尾根がいくつも並んでいる。" },
    { "kind": "MISSING", "title": "まだ見つかっていない", "text": "3 日目の昼になっても、{leader.name}さんは見つかっていない。捜索は川苔山へ登る道を中心に続いているが、どの尾根に入ったのかが分からない。北稜の北側には、似たような沢と尾根がいくつも並んでいる。" },
    { "kind": "FATAL", "when": { "flag": "planShared" }, "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。コースは家族に伝えてあったが、1002 m 標高点の先で北稜を外れたあとのことは、誰にも分からなかった。" },
    { "kind": "FATAL", "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。家族が知っていたのは「川苔山に行く」という一言だけだった。" }
  ],
  "lessons": [
    { "id": "l_study", "when": { "not": { "flag": "carefulNav" } }, "title": "バリエーションルートは下調べと読図", "text": "道標のない尾根では、尾根が分かれる所・向きが変わる所を、先に地形図で確かめておく。高度計の高さを書き込み、山頂など高さの分かる所で合わせ直す。地図・コンパス・GPS アプリを組み合わせて使う。" },
    {
      "id": "l_fork",
      "when": { "chose": { "cp": "cp_1002", "option": "follow" } },
      "title": "分かれ目では止まって、現在地を確かめる",
      "text": "なだらかで歩きやすい方へ進むと、尾根はたいてい登山道ではない方へ続いている。1002 m 標高点のように、正しい道が急な斜面へ下りる所は特に見落としやすい。迷いやすい所では必ず止まり、地図とコンパスで向きを確かめる。"
    },
    { "id": "l_back", "when": { "var": "rec.wasLost", "op": "==", "value": true }, "title": "間違いに気づいたら、すぐ戻る", "text": "おかしいと思ったら、その場で引き返す。気づいた所から戻れば、来た道は分かっている。進めば進むほど、戻る距離も、現在地の分からなさも増えていく。" },
    {
      "id": "l_drainage",
      "when": { "flag": "descendedDrainage" },
      "title": "先の分からない沢や尾根を下らない",
      "text": "「沢沿いに下れば林道に出る」は、よくある思い込み。沢には滝やゴルジュがあり、尾根の末端は崖で終わることが多い。下りてから行き詰まると、登り返す体力も時間も残っていない。林道に出られたのは、たまたまそういう沢だったからにすぎない。"
    },
    {
      "id": "l_gps",
      "when": { "var": "rec.wasLost", "op": "==", "value": true },
      "title": "現在地はすぐに分かるようにしておく",
      "text": "地形図・コンパス・高度計で現在地を絞り込むには時間がかかり、似た沢や尾根が並ぶ所では外すこともある。スマホの地図アプリ（GPS）は圏外でも現在地を示す。紙の地図と組み合わせ、予備の電池も持つ。"
    },
    {
      "id": "l_plan",
      "when": { "not": { "flag": "planShared" } },
      "title": "「川苔山に行く」では探せない",
      "text": "川苔山へ登る道はいくつもある。家族が山の名前しか知らないと、捜索は登山道を手分けして探すことから始まり、バリエーションルートにたどり着くまでに日数がかかる。登山計画書を出し、家族にコースを文字で伝える。単独の中高年は、会員制の捜索サービス（発信機を身につけるもの）にも入っておくと、見つけてもらえる見込みが大きく上がる。"
    },
    { "id": "l_solo", "when": { "var": "leader.injury", "op": "!=", "value": "none" }, "title": "単独では、小さなけがやミスが重くなる", "text": "単独で動けなくなると、知らせる人も、助けを呼びに行く人もいない。単独で歩くなら、分かれ目では必ず止まり、少しでもおかしいと思ったら戻る、という慎重さが欠かせない。" }
  ],
  "balanceTargets": { "recommended": { "goodMin": 0.97, "fatalMax": 0.01 }, "bias": { "goodMin": 0.9, "goodMax": 0.99, "fatalMax": 0.04, "lostMin": 0.15, "lostMax": 0.4 }, "risky": { "fatalMin": 0.04, "badMin": 0.06 } },
  "sources": [
    "原案: 松本圭司「架空遭難　60代単独男性、川苔山からの下山で道迷い後滑落」note（2024年3月28日） https://note.com/keizi666/n/nb9b7b6317e46",
    "地形: 国土地理院 標高タイル（DEM10B）・ベクトルタイル（植生記号）を加工",
