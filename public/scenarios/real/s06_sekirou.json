  "endings": [
    { "kind": "SAFE_RETURN", "when": { "not": { "flag": "split" } }, "title": "4 人そろって下山", "text": "4 人は一緒に大明神展望台入口へ下り、バスで相模湖駅へ戻った。湖のほとりでソフトクリームを食べて帰った。" },
    { "kind": "SAFE_RETURN", "when": { "var": "c.kenichi.phone.has", "op": "==", "value": false }, "title": "交番で再会", "text": "スマホも財布もない健一さんは、バスに乗れず、道路標識を頼りに相模湖駅まで歩いた。家族の姿はなく、電車賃を借りようと交番に寄ると、警官が「さっき相談に来た家族では」と気づいた。由美さんにこっぴどく叱られた。" },
    { "kind": "SAFE_RETURN", "title": "遅れて下山", "text": "健一さんは遅れて下山し、由美さんに電話した。「なんで電話に出ないの！」 山の中では電波が届かないこともある。別れて歩いた 1 時間は、家族にとってとても長かった。" },
    { "kind": "SELF_RESCUE", "title": "一晩の末に", "text": "健一さんは、道に迷った末に自力で車道に出た。家族と警察が夜通し探していた。" },
    { "kind": "RESCUED", "when": { "flag": "reportedMissing" }, "title": "早めの届け出", "text": "由美さんが早めに届け出て、展望台で別れたことを伝えたので、捜索はすぐ展望台の周りに向かった。健一さんは救助隊に見つけられた。" },
    { "kind": "RESCUED", "title": "救助", "text": "健一さんは救助隊に見つけられた。展望台から外れた尾根の、思いもよらない場所だった。" },
    { "kind": "RESCUED_CRITICAL", "title": "重い状態で救助", "text": "健一さんは弱った状態で見つかり、病院へ運ばれた。" },
    { "kind": "MISSING", "title": "まだ見つからない", "text": "翌日の昼になっても、健一さんは見つかっていない。展望台からは、地形図に描かれた道のない尾根や、篠原川へ落ちる谷がいくつも下っている。どこへ行ったのかは、誰にも分からない。" },
    { "kind": "FATAL", "title": "帰らぬ人に", "text": "健一さんは山から戻らなかった。家族と別れたのは、低い山の、よく整備されたハイキングコースの展望台だった。" }
  ],
  "lessons": [
    { "id": "l_split", "when": { "flag": "split" }, "title": "パーティを割らない", "text": "「先に下りてて」「すぐ追いつく」で別れると、一人になった人が静かに行き詰まっていくことがある。別れるなら、少なくとも大人 2 人以上の組にし、下では全員そろうまで待つ。" },
    { "id": "l_phone", "when": { "flag": "phoneDropped" }, "title": "休んだ場所を出るときは指差し確認", "text": "スマホ・地図・手袋・上着など、休憩中に出し入れした物はその場に忘れやすい。取りに戻れば時間と体力を失い、焦って道を間違えやすい。出発前に、いた場所を見回してお互いに確認する。スマホはストラップで留め、モバイルバッテリーを持つ。" },
    { "id": "l_cash", "when": { "flag": "split" }, "title": "スマホは命綱、でも全部は預けない", "text": "スマホは電話であり地図であり財布でもある。なくすとすべてを失う。少しの現金と、紙の地図を別に持つ。" },
    { "id": "l_wait", "when": { "chose": { "cp": "cp_busstop", "option": "station" } }, "title": "下では全員そろうまで待つ", "text": "バス停を離れると、遅れて下りてきた人と行き違いになり、連絡も取れなくなる。どうしても離れるなら、置き手紙や、バスの運転手・お店への伝言を残す。" },
    { "id": "l_report", "when": { "flag": "reportedMissing" }, "title": "早めの相談は大げさではない", "text": "低い山でも、行動時間が短い山から帰ってこないのは心配な兆候。どこで別れ、どの道を下るはずだったかを具体的に伝えると、捜索の範囲が絞れる。" },
    { "id": "l_mountain", "when": { "after": "D0 00:00" }, "title": "ハイキングも登山", "text": "整備されたハイキングコースでも、道を外れれば 10 m で歩けなくなり、転べばけがをし、暗くなれば動けない。一晩を越せるだけの服・ヘッドランプ・水と食料を持ち、山に入っているという自覚を持つ。" }
  ],
