      { "label": "今日", "text": "晴れ。日中は 24℃ くらい", "icon": "sunny" },
      { "label": "夜", "text": "晴れ。山では 10℃ 前後まで下がる", "icon": "clear_night" },
      { "label": "日の入り", "text": "18:41" }
