    { "kind": "SELF_RESCUE", "when": { "all": [{ "var": "leader.injury", "op": "!=", "value": "none" }, { "flag": "descendedDrainage" }] }, "title": "自力で道に出た", "text": "けがの体で斜面を下り、自力で道に出た。運がよかった。下に道がなければ、沢か崖で行き詰まっていたかもしれない。" },
    { "kind": "SELF_RESCUE", "when": { "var": "leader.injury", "op": "!=", "value": "none" }, "title": "自力で下山", "text": "けがの体で山の中の夜を越し、自力で下山した。家族は前の晩に届け出ていた。" },
    { "kind": "SELF_RESCUE", "when": { "var": "rec.wasLost", "op": "==", "value": true }, "title": "一晩の末に", "text": "道に迷ってツエルトで一晩過ごし、朝に自力で下山した。家族は前の晩に届け出ていた。" },
    { "kind": "SELF_RESCUE", "title": "一晩の末に", "text": "暗くなって動けず、ツエルトで一晩過ごし、朝に自力で下山した。家族は前の晩に届け出ていた。" },
    { "kind": "RESCUED", "when": { "var": "rec.rescueCalledAt", "op": "<", "value": 1320 }, "title": "自分で通報して", "text": "自分で110番し、スマホの位置情報で場所が伝わった。救助隊に収容された。" },
    { "kind": "RESCUED", "when": { "flag": "planShared" }, "title": "救助", "text": "家族に送ったコースが手がかりになり、捜索は最初からそのコースに沿って行われた。救助隊に発見された。" },
    { "kind": "RESCUED", "when": { "flag": "lead:notebook" }, "title": "小屋のノートが手がかりに", "text": "バスのカメラの映像と、小屋のノートの書き込みが手がかりになり、救助隊に発見された。" },
    { "kind": "RESCUED", "when": { "flag": "lead:bus" }, "title": "バスのカメラが手がかりに", "text": "バスのカメラで東日原で降りたことが分かり、日原から登る尾根の捜索で発見された。" },
    { "kind": "RESCUED", "title": "救助", "text": "手がかりの少ない中、救助隊に発見された。" },
    { "kind": "RESCUED_CRITICAL", "title": "衰弱した状態で救助", "text": "衰弱した状態で発見され、病院へ運ばれた。" },
    { "kind": "MISSING", "when": { "var": "rec.rescueCalledAt", "op": "<", "value": 1320 }, "title": "まだ収容されていない", "text": "4日目の夕方になっても、救助隊はたどり着けていない。通報の場所から動いてしまったのかもしれない。" },
    { "kind": "MISSING", "when": { "any": [{ "flag": "planShared" }, { "flag": "lead:notebook" }] }, "title": "まだ見つかっていない", "text": "4日目の夕方になっても見つかっていない。捜索はコースの周りに絞られているが、茂った森の中は上空からほとんど見えない。" },
    { "kind": "MISSING", "title": "まだ見つかっていない", "text": "4日目の夕方になっても見つかっていない。どの尾根に入ったのか分からず、茂った森の中は上空からほとんど見えない。" },
    { "kind": "FATAL", "when": { "before": "D0 22:00" }, "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。家族が心配し始めるより前のことだった。" },
    { "kind": "FATAL", "when": { "var": "rec.rescueCalledAt", "op": "<", "value": 1320 }, "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。通報はできたが、救助隊が着くまで持たなかった。" },
    { "kind": "FATAL", "when": { "flag": "planShared" }, "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。捜索はすぐコースに沿って始まったが、間に合わなかった。" },
    { "kind": "FATAL", "when": { "flag": "lead:notebook" }, "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。ノートの書き込みで捜索は鳥屋戸尾根に移ったが、間に合わなかった。" },
    { "kind": "FATAL", "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。家族が知っていたのは「奥多摩に行く」の一言だけだった。" }
  ],
  "lessons": [
    { "id": "l_plan", "when": { "not": { "flag": "planShared" } }, "title": "「奥多摩に行く」では探せない", "text": "降りたバス停が分かっても、そこから登れる尾根はいくつもある。登山計画を出し、家族には山とコースを文字で伝える。位置を共有するアプリや捜索用の発信機も手がかりになる。" },
    { "id": "l_note", "when": { "flag": "lead:notebook" }, "title": "小屋のノートは手がかりになる", "text": "ノートに残したコースが、捜索の範囲を絞った。ただし見つかるのは捜索隊が小屋に来てからで、時間がかかる。" },
    { "id": "l_beer", "when": { "chose": { "cp": "cp_hut", "option": "beer" } }, "title": "行動中の飲酒と長い昼食", "text": "ビールは判断と足元を鈍らせる。1時間半の昼食で、雲の下がる時間に薄い尾根を歩くことになった。飲むなら泊まりの山で。" },
    { "id": "l_nav", "when": { "chose": { "cp": "cp_fork", "option": "follow" } }, "title": "道をよく見て、尾根の分かれ目では止まる", "text": "歩きやすい方の尾根は、たいてい道から外れていく。踏み跡の凹みや地面の固さを見て「読図→ルート維持→現在地の確認」を回す。尾根が広がる所・曲がる所では必ず止まる。" },
    { "id": "l_phone", "when": { "var": "leader.phone.has", "op": "==", "value": false }, "title": "スマホは命綱。ストラップで留める", "text": "転んだ拍子にスマホをなくし、通報できなくなった。落ち葉の斜面で探すのはほぼ無理。ストラップで体に留める。" },
    { "id": "l_solo", "when": { "var": "leader.injury", "op": "!=", "value": "none" }, "title": "単独行は、小さなけがが命取りになる", "text": "単独で動けなくなると、助けを呼ぶ人がいない。単独の遭難は死亡の割合がずっと高い。慎重さと計画の共有が欠かせない。" },
    { "id": "l_stay", "when": { "any": [{ "chose": { "cp": "cp_day2", "option": "slide" } }, { "chose": { "cp": "cp_day3", "option": "slide" } }, { "chose": { "cp": "generic:injured", "option": "slide" } }] }, "title": "下ればどこかに出る、とは限らない", "text": "尾根の末端は、たいてい沢か崖で終わる。現在地が分からないまま下るのは賭けだ。" }
  ],
  "balanceTargets": {
    "recommended": { "goodMin": 0.9, "fatalMax": 0.02 },
    "bias": { "fatalMin": 0.03, "fatalMax": 0.2, "badMin": 0.06, "goodMax": 0.85 },
    "risky": { "fatalMin": 0.2 }
  },
  "sources": [
    "原案: 松本圭司「架空遭難　登山歴8年の65歳ソロ男性、鳥屋戸尾根で滑落負傷」note（2024年2月9日） https://note.com/keizi666/n/n76b9b9209d27",
