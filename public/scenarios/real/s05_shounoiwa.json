    { "kind": "MISSING", "when": { "any": [{ "flag": "planShared" }, { "flag": "lead:notebook" }] }, "title": "まだ見つかっていない", "text": "4日目の夕方になっても、{leader.name}さんは見つかっていない。捜索はコースの周りに絞られているが、葉の茂った森の中は、上空からはほとんど見えない。" },
    { "kind": "MISSING", "title": "まだ見つかっていない", "text": "4日目の夕方になっても、{leader.name}さんは見つかっていない。捜索は続いているが、どの尾根に入ったのかが分からない。葉の茂った森の中は、上空からはほとんど見えない。" },
    { "kind": "FATAL", "when": { "before": "D0 22:00" }, "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。家族が帰りを心配しはじめるより前のことだった。" },
