  "endings": [
    { "kind": "SAFE_RETURN", "when": { "all": [{ "beenAt": "TH_KAWANORI" }, { "var": "rec.wasLost", "op": "==", "value": true }] }, "title": "引き返して、川乗橋へ", "text": "{leader.name}さんは一度、鳥屋戸尾根から外れて踏み跡のない斜面に入り込んだ。道に戻り、川乗橋のバス停に下りた。気づくのが遅れていれば、急な斜面の先で行き詰まっていたかもしれない。" },
    { "kind": "SAFE_RETURN", "when": { "beenAt": "TH_KAWANORI" }, "title": "川乗橋に下りた", "text": "{leader.name}さんは鳥屋戸尾根を下りきり、川乗橋のバス停に出た。踏み跡の薄い尾根を、最後まで外さずに歩いた。" },
    { "kind": "SAFE_RETURN", "when": { "chose": { "cp": "cp_sobatsubu", "option": "back" } }, "title": "来た道を戻った", "text": "{leader.name}さんは東日原のバス停に戻った。鳥屋戸尾根は、また天気のいい日に歩けばいい。" },
    { "kind": "SAFE_RETURN", "title": "東日原に下りた", "text": "{leader.name}さんは東日原のバス停に下りた。予定のコースではなかったが、無事に帰れた。" },
    { "kind": "SELF_RESCUE", "when": { "all": [{ "var": "leader.injury", "op": "!=", "value": "none" }, { "flag": "descendedDrainage" }] }, "title": "自力で道に出た", "text": "{leader.name}さんは、けがをした体で斜面を下り、自力で道に出た。運がよかった。尾根の下に道がなければ、沢か崖で行き詰まっていたかもしれない。" },
    { "kind": "SELF_RESCUE", "when": { "var": "leader.injury", "op": "!=", "value": "none" }, "title": "自力で下山", "text": "{leader.name}さんは、けがをした体で山の中で夜を越し、自力で下山した。家族は前の晩に警察に届け出ていた。" },
    { "kind": "SELF_RESCUE", "when": { "var": "rec.wasLost", "op": "==", "value": true }, "title": "一晩の末に", "text": "{leader.name}さんは道に迷い、ツエルトで一晩を過ごした。朝になって、自力で下山した。家族は前の晩に警察に届け出ていた。" },
    { "kind": "SELF_RESCUE", "title": "一晩の末に", "text": "{leader.name}さんは暗くなって動けなくなり、ツエルトで一晩を過ごした。朝になって、自力で下山した。家族は前の晩に警察に届け出ていた。" },
    { "kind": "RESCUED", "when": { "var": "rec.rescueCalledAt", "op": "<", "value": 1320 }, "title": "自分で通報して", "text": "{leader.name}さんは自分で 110 番し、スマホの位置情報で場所が伝わった。{leader.name}さんは救助隊に収容された。" },
    { "kind": "RESCUED", "when": { "flag": "planShared" }, "title": "救助", "text": "家族に送っておいたコースが手がかりになり、捜索は最初からそのコースに沿って行われた。{leader.name}さんは救助隊に発見された。" },
    { "kind": "RESCUED", "when": { "flag": "lead:notebook" }, "title": "小屋のノートが手がかりに", "text": "バスのカメラの映像と、一杯水避難小屋のノートの書き込みが手がかりになった。{leader.name}さんは救助隊に発見された。" },
    { "kind": "RESCUED", "when": { "flag": "lead:bus" }, "title": "バスのカメラが手がかりに", "text": "バスの車内カメラの映像から東日原で降りたことが分かり、日原から登る尾根の捜索で、{leader.name}さんは救助隊に発見された。" },
    { "kind": "RESCUED", "title": "救助", "text": "{leader.name}さんは救助隊に発見された。手がかりの少ない中での発見だった。" },
    { "kind": "RESCUED_CRITICAL", "title": "衰弱した状態で救助", "text": "{leader.name}さんは衰弱した状態で発見され、病院へ運ばれた。" },
