    { "kind": "FATAL", "when": { "flag": "planShared" }, "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。家族はコースを知っていて、捜索はすぐにそのコースに沿って始まったが、間に合わなかった。" },
    { "kind": "FATAL", "when": { "flag": "lead:notebook" }, "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。小屋のノートの書き込みで、捜索は鳥屋戸尾根に移ったが、間に合わなかった。" },
    { "kind": "FATAL", "title": "帰らぬ人に", "text": "{leader.name}さんは山から戻らなかった。家族が知っていたのは「奥多摩に行く」という一言だけだった。" }
  ],
  "lessons": [
    { "id": "l_plan", "when": { "not": { "flag": "planShared" } }, "title": "「奥多摩に行く」では探せない", "text": "家族が知っていたのは「奥多摩」だけだった。バスのカメラで降りたバス停が分かっても、そこから登れる尾根はいくつもある。登山計画を出し、家族には山の名前とコースを文字（LINE など）で伝えておく。位置情報を共有するアプリや、捜索用の発信機（会員制の捜索サービス）も手がかりになる。" },
    { "id": "l_note", "when": { "flag": "lead:notebook" }, "title": "小屋のノートは手がかりになる", "text": "避難小屋のノートに残したコースが、捜索の範囲を絞る手がかりになった。ただし、ノートが見つかるのは捜索隊が小屋まで来てからで、それまでに時間がかかる。" },
    { "id": "l_beer", "when": { "chose": { "cp": "cp_hut", "option": "beer" } }, "title": "行動中の飲酒と長い昼食", "text": "ビールは判断と足元を鈍らせ、1時間半の昼食で、雲の下がる時間帯に踏み跡の薄い尾根を歩くことになった。山で飲みたいなら泊まりの山行にする。" },
    { "id": "l_nav", "when": { "chose": { "cp": "cp_fork", "option": "follow" } }, "title": "道をよく見て、尾根の分かれ目では止まる", "text": "歩きやすそうな方へ進むと、尾根はたいてい登山道ではない方へ分かれていく。踏み跡のわずかな凹みや地面の固さを意識し、「先読み（読図）→ルート維持→現在地の確認」を回す。尾根が広くなったところ、向きが変わるところでは必ず止まる。" },
    { "id": "l_phone", "when": { "var": "leader.phone.has", "op": "==", "value": false }, "title": "スマホは命綱。ストラップで留める", "text": "転んだ拍子にスマホがなくなり、通報の手段を失った。落ち葉の積もった斜面で、飛んだスマホを見つけるのはほぼ無理。ケースとストラップで体に留めておく。" },
    { "id": "l_solo", "when": { "var": "leader.injury", "op": "!=", "value": "none" }, "title": "単独行は、小さなけがが命取りになる", "text": "単独で動けなくなると、知らせる人も、助けを呼びに行く人もいない。単独の遭難は、パーティより死亡の割合がずっと高い。単独で歩くなら、小さなけがやミスもしない慎重さと、計画の共有が欠かせない。" },
    { "id": "l_stay", "when": { "any": [{ "chose": { "cp": "cp_day2", "option": "slide" } }, { "chose": { "cp": "cp_day3", "option": "slide" } }, { "chose": { "cp": "generic:injured", "option": "slide" } }] }, "title": "下ればどこかに出る、とは限らない", "text": "尾根の末端は、たいてい沢か崖で終わる。どこにいるか分からないまま下るのは賭けになる。下った先に道があるかどうかは、運しだいだ。" }
  ],
  "balanceTargets": {
    "recommended": { "goodMin": 0.9, "fatalMax": 0.02 },
    "bias": { "fatalMin": 0.03, "fatalMax": 0.2, "badMin": 0.06, "goodMax": 0.85 },
    "risky": { "fatalMin": 0.2 }
  },
