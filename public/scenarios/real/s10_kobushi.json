    { "kind": "SAFE_RETURN", "when": { "all": [{ "beenAt": "KOBUSHI_HUT" }, { "var": "leader.illness", "op": "==", "value": "mi" }] }, "title": "小屋にたどり着いたが", "text": "岡田さんは甲武信小屋にたどり着き、主人がすぐ通報した。病院で急性心筋梗塞と診断された。歩く間に心臓が止まってもおかしくなかった。" },
    { "kind": "SAFE_RETURN", "when": { "beenAt": "KOBUSHI_HUT" }, "title": "小屋にたどり着いて", "text": "岡田さんは甲武信小屋にたどり着き、翌日ゆっくり下山して受診した。原因ははっきりせず、医師には「山はしばらく控えて」と言われた。" },
    { "kind": "SAFE_RETURN", "title": "大弛小屋に戻った", "text": "岡田さんは大弛小屋まで引き返し、翌日車で下りて受診した。" },
    { "kind": "SELF_RESCUE", "when": { "all": [{ "var": "leader.illness", "op": "==", "value": "benign" }, { "after": "D1 00:00" }] }, "title": "一晩を越して", "text": "ツエルトで一晩を越すと痛みは引き、岡田さんは自分の足で小屋まで歩いた。受診すると心臓に異常はなく、胃か筋肉の痛みだったらしい。それでも、あの晩動かなかった判断はまちがっていなかった。" },
    { "kind": "SELF_RESCUE", "when": { "var": "leader.illness", "op": "==", "value": "benign" }, "title": "痛みが引いて", "text": "ツエルトで休むうちに痛みが引き、岡田さんは自分の足で小屋まで歩いた。受診すると心臓に異常はなく、胃か筋肉の痛みだったらしい。それでも、止まって様子を見た判断はまちがっていなかった。" },
    { "kind": "SELF_RESCUE", "when": { "after": "D1 00:00" }, "title": "一晩を越して", "text": "ツエルトで一晩を越し、岡田さんは自分の足で小屋まで歩いた。下山してすぐ受診した。" },
    { "kind": "SELF_RESCUE", "title": "痛みが引いて", "text": "ツエルトで休んで痛みが引くのを待ち、岡田さんは自分の足で小屋まで歩いた。下山してすぐ受診した。" },
    { "kind": "RESCUED", "when": { "all": [{ "var": "leader.illness", "op": "==", "value": "mi" }, { "not": { "chose": { "cp": "cp_onset", "option": "push" } } }, { "not": { "chose": { "cp": "cp_not_eased", "option": "push" } } }, { "not": { "chose": { "cp": "cp_relapse", "option": "push" } } }] }, "title": "救助", "text": "岡田さんは救助隊に収容され、急性心筋梗塞と診断された。動かずに待ったことが、命をつないだのかもしれない。" },
    { "kind": "RESCUED", "when": { "var": "leader.illness", "op": "==", "value": "mi" }, "title": "救助", "text": "岡田さんは救助隊に収容され、急性心筋梗塞と診断された。痛みをこらえて歩く間に、心臓が止まってもおかしくなかった。" },
    { "kind": "RESCUED", "title": "救助", "text": "岡田さんは救助隊に見つけられ、病院へ運ばれた。" },
    { "kind": "RESCUED_CRITICAL", "title": "重い状態で救助", "text": "岡田さんは弱った状態で見つかり、病院へ運ばれた。" },
    { "kind": "FATAL", "when": { "var": "leader.illness", "op": "==", "value": "dissection" }, "title": "帰らぬ人に", "text": "岡田さんは稜線で亡くなった。後に、大動脈解離だったと分かった。" },
    { "kind": "FATAL", "when": { "var": "leader.illness", "op": "==", "value": "mi" }, "title": "帰らぬ人に", "text": "岡田さんは稜線で亡くなった。急性心筋梗塞だった。人の少ない道で、誰にも気づかれなかった。" },
    { "kind": "FATAL", "title": "帰らぬ人に", "text": "岡田さんは山から戻らなかった。" },
    { "kind": "MISSING", "title": "まだ見つからない", "text": "日曜の夕方になっても、岡田さんは見つかっていない。" }
  ],
  "lessons": [
    { "id": "l_check", "when": { "flag": "onset" }, "title": "健康診断と、不調のときは中止", "text": "年をとると、山での急病が増える。定期的に健康診断を受け、体調に不安があれば山行を中止して受診する。" },
    { "id": "l_meds", "when": { "flag": "onset" }, "title": "持病と薬を伝えておく", "text": "持病があれば、薬の場所と使い方（ニトログリセリンの舌下など）を同行者に伝える。単独なら家族や登山届にも書く。" },
    { "id": "l_rest", "when": { "any": [{ "chose": { "cp": "cp_onset", "option": "push" } }, { "chose": { "cp": "cp_not_eased", "option": "push" } }, { "chose": { "cp": "cp_relapse", "option": "push" } }] }, "title": "胸の痛みで、歩き続けない", "text": "原因の分からない胸の痛みで歩き続けると、心臓の病気なら命に関わる。まず座って様子を見る。治まらなければ動かない。" },
    { "id": "l_solo", "when": { "flag": "onset" }, "title": "人の少ない道を一人で歩く危うさ", "text": "単独の遭難は、パーティより死亡の割合がずっと高い。年をとったら仲間と行くか、電波が入り逃げ道の近い山を選ぶ。発信機（会員制の捜索サービス）があれば見つけてもらいやすい。" },
    { "id": "l_signal", "when": { "any": [{ "state": "BIVOUAC" }, { "state": "WAITING_RESCUE" }] }, "title": "待つ間にできること", "text": "風を避けて着込み、湯を沸かして体を温める。登山道から離れない。人の気配がしたら笛を短く 3 回。夜はヘッドランプ、昼は目立つ色の物で合図する。通る人に渡すメモも書いておく。" },
    { "id": "l_hut", "when": { "after": "D0 19:00" }, "title": "小屋の予約も、命綱の一つ", "text": "予約客が来なければ、小屋の人が気づいてくれることがある。行き先と予定は、届け・家族・小屋の三つに残す。" }
  ],
  "balanceTargets": {
    "recommended": { "fatalMax": 0.2 }
  },
