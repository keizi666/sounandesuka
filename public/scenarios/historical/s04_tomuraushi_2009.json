 "choices": [
  {
   "id": "cp_depart",
   "title": "ヒサゴ沼避難小屋の朝",
   "group": "main",
   "priority": 20,
   "trigger": {
    "after": "D0 04:45"
   },
   "situation": "午前4時45分。夜半からの風雨がまだ残っている。昨日の雨で衣類や靴下は湿ったままの人が多い。ラジオの予報は「曇り、昼から回復」。予定では5時に出発し、山頂を巻いて短縮コース登山口まで約10時間半の行程。",
   "knowledge": [
    "予報（平地）は昼から回復",
    "この先は風を遮るもののない稜線が続く",
    "日程に予備日はない。遅れれば帰りの便に間に合わない",
    "小屋には非常食・毛布・断熱マットがある"
   ],
   "options": [
    {
     "id": "delay30",
     "label": "30分遅らせて出発する",
     "detail": "風雨が少し落ち着くのを待つ。昼からは回復するはず。",
     "actions": [
      {
       "type": "rest",
       "minutes": 30
      },
      {
       "type": "continueRoute"
      }
     ],
     "tags": [
      "risky"
     ],
     "bias": {
      "base": 1.0,
      "mods": [
       {
        "when": {
         "var": "leader.def.riskTolerance",
         "op": ">",
         "value": 0.5
        },
        "add": 0.5
       }
      ]
     }
    },
    {
     "id": "stay",
     "label": "出発を見合わせ、天候が回復するまで小屋にとどまる",
     "detail": "下山は1日遅れる。会社と家族への連絡手段を探す必要がある。",
     "actions": [
      {
       "type": "stayInShelter",
       "until": "weatherClears"
      }
     ],
     "tags": [
      "recommended"
     ],
     "bias": {
