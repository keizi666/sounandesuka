  "lessons": [
    {
      "id": "l_late",
      "when": {
        "chose": {
          "cp": "cp_summit",
          "option": "loop"
        }
      },
      "title": "遅れたときに「知らない道」を選ばない",
      "text": "予定より遅れ、霧が出ている状況で初めての道を選んだ。疲れと時間の焦りがある時ほど、知っている道や小屋という選択肢が効いてくる。"
    },
    {
      "id": "l_check",
      "when": {
        "chose": {
          "cp": "cp_saddle",
          "option": "follow"
        }
      },
      "title": "分岐では必ず立ち止まる",
      "text": "はっきりした踏み跡が正しい道とは限らない。廃道や作業道、獣道のほうが明瞭なこともある。分岐では止まって、地図と現在地を確かめる。"
    },
    {
      "id": "l_descend",
      "when": {
        "chose": {
          "cp": "generic:lostAware",
          "option": "descend"
        }
      },
      "title": "迷ったら沢へ下らない",
      "text": "「下れば道に出る」は山では成り立たないことが多い。沢は下るほど険しくなり、滝で行き詰まり、電波も届かず、上空から見つけてもらいにくい。迷ったら、分かるところまで登り返す。"
    },
    {
      "id": "l_plan",
      "when": {
        "var": "rec.wasLost",
        "op": "==",
        "value": true
      },
      "title": "登山計画書と下山連絡",
      "text": "計画書を出していなかったため、捜索はルートの特定から始まった。計画書と「何時までに連絡がなければ通報」という取り決めが、捜索の早さを変える。"
    },
    {
      "id": "l_lamp",
      "when": {
        "var": "rec.darkMinutesMoving",
        "op": ">",
        "value": 30
      },
      "title": "ヘッドランプは一人一つ",
      "text": "暗闇の中を{rec.darkMinutesMoving:0}分行動した。明かりのない人は足元が見えず、転倒や道迷いの危険が大きく増える。日帰りでもヘッドランプと予備電池は全員が持つ。"
    }
  ],
